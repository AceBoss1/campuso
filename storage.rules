rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function underSizeLimit() {
      return request.resource.size < 8 * 1024 * 1024;
    }

    match /avatars/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isImage() && underSizeLimit();
    }

    match /posts/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isImage() && underSizeLimit();
    }

    match /chats/{chatId}/{fileName} {
      allow read, write: if isSignedIn() && isImage() && underSizeLimit();
    }
  }
}
